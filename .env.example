# Backend — Groq (LLM gratuit / low-cost) + RAG local (embeddings gratuits)
#
# 1) Groq : https://console.groq.com/keys — la clé commence par gsk_
GROQ_API_KEY=
# Modèle par défaut : rapide, peu de tokens, textes 100 % LLM (recommandé MVP).
GROQ_MODEL=llama-3.1-8b-instant
# Alternative qualité max (plus de quota) : GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Docker Desktop : souvent requis (sinon APIConnectionError). L’UI affiche « OK réseau Docker » (cyan).
GROQ_INSECURE_SKIP_SSL_VERIFY=1

# Limite appels Groq (évite 429) : max panneaux avec texte LLM, taille des lots, pause (s)
GROQ_MAX_PANELS_LLM=15
GROQ_BATCH_SIZE=8
GROQ_BATCH_DELAY_S=2.0
GROQ_MIN_INTERVAL_S=2.5
GROQ_PANEL_COPY_RETRIES=3

# Rétrocompat : vous pouvez mettre la même clé Groq ici au lieu de GROQ_API_KEY
# OPENAI_API_KEY=gsk_...

# Embeddings RAG gratuits (FastEmbed, CPU). Modèle multilingue adapté au FR.
EMBEDDING_BACKEND=auto
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Si vous aviez une ancienne collection OpenAI (dimensions différentes), changez le nom ou supprimez backend/app/.chroma
RAG_COLLECTION=smart_planning_rag_bge
CHROMA_PERSIST_DIR=app/.chroma

# OpenAI optionnel (payant) — LLM et/ou embeddings si EMBEDDING_BACKEND=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
